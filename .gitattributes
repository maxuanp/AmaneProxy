# 容器 / shell / 代码文件统一用 LF；Windows 专用脚本保持 CRLF
*.sh                text eol=lf
Dockerfile          text eol=lf
*.yml               text eol=lf
*.py                text eol=lf
*.md                text eol=lf
*.html              text eol=lf
*.json              text eol=lf
# 无扩展名的文本文件 (上面的通配规则匹配不到)
.gitattributes      text eol=lf
.gitignore          text eol=lf
.dockerignore       text eol=lf
LICENSE             text eol=lf
*.ps1               text eol=crlf
*.vbs               text eol=crlf
*.cmd               text eol=crlf
*.ico               binary
